#VERSION='7.8.0'
#MYSQL_USER='admin'
#MYSQL_PASS='**Random**'
#DISABLE_INOTIFYWAIT_CLEAN=0
#DB_NAME=''
#DB_USER=''
#DB_PASSWORD=''
#DB_HOST=''
#DB_PORT='3306'
#FORCE_INSTALL=0
#AMPACHE_DB_USER=''
#AMPACHE_DB_PASSWORD=''
#AMPACHE_ADMIN_USER='admin'
#AMPACHE_ADMIN_PASSWORD='**Random**'
#AMPACHE_ADMIN_EMAIL=''
#AMPACHE_URL='https://demo.ampache.dev'
# client install script: ample.sh or tinysub.sh
#CLIENT_INSTALL='ample.sh'
# release tag to install, or latest
#CLIENT_VERSION='latest'
# install from a local zip instead of downloading (ample only)
#CLIENT_ZIP=''
# reinstall/rebuild the client even when it is already installed
#CLIENT_FORCE=0
# tinysub.sh only. these are baked into the build, never use real credentials
#TINYSUB_SERVER=''
#TINYSUB_SERVER_LOCK=false
#TINYSUB_USERNAME=''
#TINYSUB_PASSWORD=''
#TINYSUB_NAME=''
#TINYSUB_BASE_URL='/'
#TINYSUB_BUILD_TARGET=''
#TINYSUB_DIST=''
